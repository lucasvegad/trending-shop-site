---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
}
const { title, description, noindex = false, canonicalPath } = Astro.props;
const canonicalURL = canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/bolsi.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --orange: #FF6316;
        --navy: #0F172A;
        --slate: #313748;
        --offwhite: #F7F5F2;
        --font-display: "Baloo 2", sans-serif;
        --font-text: "Inter", -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-text);
        background: var(--offwhite);
        color: var(--navy);
      }
      h1, h2 {
        font-family: var(--font-display);
        font-weight: 800;
      }
      header {
        padding: 1rem 1.5rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      header a {
        color: white;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      header img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--orange);
      }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--slate);
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <header><a href="/"><img src="/bolsi.png" alt="Bolsi, la mascota de Trending Shop" />Trending Shop</a></header>
    <main>
      <slot />
    </main>
    <footer>Trending Shop — ofertas reales de Mercado Libre Argentina. Los links son de afiliado.</footer>
  </body>
</html>
