---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
}
const { title, description, noindex = false, canonicalPath } = Astro.props;
const canonicalURL = canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --orange: #FF6316;
        --navy: #0F172A;
        --slate: #313748;
        --offwhite: #F7F5F2;
        --font-display: "Baloo 2", sans-serif;
        --font-text: "Inter", -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-text);
        color: var(--navy);
        background:
          radial-gradient(ellipse 900px 500px at 15% -10%, #FFE4D2 0%, transparent 60%),
          radial-gradient(ellipse 700px 500px at 100% 0%, #FFD9C2 0%, transparent 55%),
          var(--offwhite);
        background-attachment: fixed;
      }
      h1, h2 {
        font-family: var(--font-display);
        font-weight: 800;
      }
      header {
        padding: 1rem 1.5rem;
        background: var(--navy);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        box-shadow: 0 2px 12px rgba(15, 23, 42, 0.25);
      }
      header a {
        color: white;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      header img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
      }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      footer {
        background: var(--navy);
        color: rgba(255, 255, 255, 0.7);
        padding: 2.5rem 1.5rem 1.5rem;
        margin-top: 2rem;
      }
      .footer-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .footer-grid h3 {
        color: white;
        font-family: var(--font-display);
        font-size: 0.95rem;
        margin: 0 0 0.75rem;
      }
      .footer-grid ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .footer-grid li {
        margin-bottom: 0.5rem;
      }
      .footer-grid a {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 0.9rem;
      }
      .footer-grid a:hover {
        color: white;
        text-decoration: underline;
      }
      .footer-tagline {
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
      }
      .footer-signature {
        max-width: 900px;
        margin: 2rem auto 0;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.8rem;
      }
      .footer-signature img {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: white;
        padding: 3px;
      }
    </style>
  </head>
  <body>
    <header><a href="/"><img src="/bolsi.png" alt="Bolsi, la mascota de Trending Shop" />Trending Shop</a></header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-grid">
        <div>
          <h3>Trending Shop</h3>
          <p class="footer-tagline">Ofertas reales de Mercado Libre Argentina, con descuento verificado, todos los días.</p>
        </div>
        <div>
          <h3>Categorías</h3>
          <ul>
            <li><a href="/?categoria=Tecnología">Tecnología</a></li>
            <li><a href="/?categoria=Hogar">Hogar</a></li>
            <li><a href="/?categoria=Salud y Belleza">Salud y Belleza</a></li>
            <li><a href="/?categoria=Deportes y Fitness">Deportes y Fitness</a></li>
            <li><a href="/?categoria=Moda">Moda</a></li>
            <li><a href="/?categoria=Juguetes y Hobbies">Juguetes y Hobbies</a></li>
          </ul>
        </div>
        <div>
          <h3>Legal</h3>
          <ul>
            <li><a href="/terminos">Términos de uso</a></li>
            <li><a href="/privacidad">Privacidad</a></li>
            <li><a href="/sobre-afiliados">Sobre los links de afiliado</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-signature">
        <img src="/logo.jpg" alt="Trending Shop" />
        <span>© {new Date().getFullYear()} Trending Shop — todos los derechos reservados.</span>
      </div>
    </footer>
  </body>
</html>
