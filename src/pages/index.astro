---
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import { getTodayOffers, getActiveCategories, getLatestDate } from '../lib/data';

const latestDate = getLatestDate();
const todayOffers = getTodayOffers().sort((a, b) => b.discount_pct - a.discount_pct);
const categories = getActiveCategories();
const bestDealId = todayOffers[0]?.product_id;
---
<Base
  title="Trending Shop — Ofertas de Mercado Libre Argentina"
  description="Ofertas reales con descuento verificado de Mercado Libre Argentina, actualizadas todos los días."
  noindex={true}
>
  <h1>Ofertas de hoy{latestDate ? ` (${latestDate})` : ''}</h1>

  <div class="toolbar">
    <input id="search" type="search" placeholder="Buscar producto..." aria-label="Buscar producto" />
    <select id="category-filter" aria-label="Filtrar por categoría">
      <option value="">Todas las categorías</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
  </div>

  {todayOffers.length === 0 && <p>Todavía no hay ofertas publicadas.</p>}

  <div class="grid" id="offers-grid">
    {todayOffers.map((o) => (
      <OfferCard offer={o} isBestDeal={o.product_id === bestDealId} />
    ))}
  </div>
  <p id="no-results" class="no-results" hidden>No encontramos ofertas con ese filtro.</p>
</Base>

<style>
  .toolbar {
    display: flex;
    gap: 0.75rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }
  .toolbar input,
  .toolbar select {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: white;
    color: #0F172A;
  }
  .toolbar input {
    flex: 1;
    min-width: 200px;
  }
  .toolbar input:focus,
  .toolbar select:focus {
    outline: 2px solid #FF6316;
    outline-offset: 1px;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .no-results {
    text-align: center;
    color: #313748;
    padding: 2rem 0;
  }
</style>

<script>
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const categorySelect = document.getElementById('category-filter') as HTMLSelectElement;
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.offer-card'));
  const noResults = document.getElementById('no-results') as HTMLElement;

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    const category = categorySelect.value;
    let visibleCount = 0;

    for (const card of cards) {
      const matchesQuery = !query || card.dataset.title?.includes(query);
      const matchesCategory = !category || card.dataset.category === category;
      const visible = Boolean(matchesQuery && matchesCategory);
      card.hidden = !visible;
      if (visible) visibleCount++;
    }

    noResults.hidden = visibleCount > 0;
  }

  const presetCategory = new URLSearchParams(window.location.search).get('categoria');
  if (presetCategory) {
    categorySelect.value = presetCategory;
  }

  searchInput?.addEventListener('input', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);
  applyFilters();
</script>
