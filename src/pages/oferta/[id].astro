---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import RatingStars from '../../components/RatingStars.astro';
import PriceBlock from '../../components/PriceBlock.astro';
import { getAllOffers, getLatestDate } from '../../lib/data';
import { money } from '../../lib/format';
import { getBenefit, getReasons, TRUST_CTA_LINE } from '../../lib/copy';
import type { Offer } from '../../lib/types';

const overallLatestDate = getLatestDate();

export function getStaticPaths() {
  const allOffers = getAllOffers();
  const byProduct = new Map<string, Offer[]>();
  for (const o of allOffers) {
    const list = byProduct.get(o.product_id) ?? [];
    list.push(o);
    byProduct.set(o.product_id, list);
  }
  return Array.from(byProduct.entries()).map(([product_id, history]) => ({
    params: { id: product_id },
    props: { history },
  }));
}

const { history } = Astro.props as { history: Offer[] };
const current = history[0];
const isActive = current.published_date === overallLatestDate;

// "past" ya viene en orden descendente (más reciente primero, ver export_public_offers.py).
// Cada fila se compara contra la próxima más antigua para marcar si el precio subió o bajó.
const past = history.slice(1).map((p, i, arr) => {
  const older = arr[i + 1];
  let delta: 'up' | 'down' | null = null;
  if (older) {
    if (p.price_after < older.price_after) delta = 'down';
    else if (p.price_after > older.price_after) delta = 'up';
  }
  return { ...p, delta };
});

const benefit = getBenefit(current);
const reasons = getReasons(current);

const pageDescription = `${current.title}: ${current.discount_pct}% OFF, ${money(current.price_after)} en Mercado Libre Argentina.`;
const canonicalPath = `/oferta/${current.product_id}`;
const pageUrl = new URL(canonicalPath, Astro.site).toString();

const productJsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: current.title,
  ...(current.image_url && { image: [current.image_url] }),
  description: pageDescription,
  sku: current.product_id,
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    priceCurrency: 'ARS',
    price: current.price_after,
    availability: isActive ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
// Escapa "<" para que un título con "</script>" no rompa el tag del JSON-LD.
const productJsonLdString = JSON.stringify(productJsonLd).replace(/</g, '\\u003c');
---
<Base
  title={`${current.title} — Trending Shop`}
  description={pageDescription}
  canonicalPath={canonicalPath}
>
  <script type="application/ld+json" set:html={productJsonLdString} />
  <a href="/" class="back-link">← Volver a las ofertas</a>

  <div class="product-layout">
    <div class="product-image-col">
      {current.image_url && <img src={current.image_url} alt={current.title} class="product-image" />}
    </div>

    <div class="buy-box">
      {current.trending && <Badge variant="green" size="sm" label="🔥 Tendencia" />}
      <h1>{current.title}</h1>

      {!isActive && (
        <p class="inactive-chip">
          ⚠️ Esta oferta ya no está activa (vista por última vez el {current.published_date}). Mirá las <a href="/">ofertas de hoy</a>.
        </p>
      )}

      <PriceBlock
        priceAfter={current.price_after}
        priceBefore={current.price_before}
        discountPct={current.discount_pct}
        installmentsText={current.installments_text}
        size="detail"
      />
      <RatingStars rating={current.rating} soldText={current.sold_text} />

      <p class="benefit">{benefit}</p>
      <ul class="reasons">
        {reasons.map((r) => <li>{r}</li>)}
      </ul>

      {isActive && (
        <>
          <a href={current.affiliate_link} rel="nofollow sponsored" target="_blank" class="cta">
            Ver oferta en Mercado Libre
          </a>
          <p class="trust-line">{TRUST_CTA_LINE}</p>
        </>
      )}
    </div>
  </div>

  {past.length > 0 && (
    <section class="price-history">
      <h2>Historial de precios</h2>
      <ul>
        {past.map((p) => (
          <li>
            {p.delta === 'up' && <span class="delta delta-up">▲</span>}
            {p.delta === 'down' && <span class="delta delta-down">▼</span>}
            <span class="history-date">{p.published_date}:</span>
            <span class="history-price">{money(p.price_after)}</span>
            <span class="history-discount">({p.discount_pct}% OFF)</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .back-link {
    color: var(--slate, #313748);
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  @media (min-width: 700px) {
    .product-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
    }
    .product-image-col {
      position: sticky;
      top: 1.5rem;
    }
  }

  .product-image {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 4px 8px rgba(15, 23, 42, 0.08), 0 16px 32px rgba(15, 23, 42, 0.1);
    display: block;
  }

  .buy-box {
    background: white;
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 8px 20px rgba(15, 23, 42, 0.06);
  }
  .buy-box h1 {
    font-size: 1.3rem;
    margin: 0.5rem 0 0.75rem;
    line-height: 1.35;
  }

  .inactive-chip {
    background: #FFF3E0;
    border: 1px solid var(--orange);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--slate, #313748);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .benefit {
    margin: 0.9rem 0 0;
    font-weight: 600;
    color: var(--navy);
  }
  .reasons {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--slate, #313748);
  }
  .reasons li {
    margin-bottom: 0.25rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1.1rem;
    background: var(--orange);
    color: white;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(255, 99, 22, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(255, 99, 22, 0.45);
  }
  .trust-line {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--slate, #313748);
    opacity: 0.85;
  }

  .price-history {
    margin-top: 2rem;
    background: white;
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 8px 20px rgba(15, 23, 42, 0.06);
  }
  .price-history h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  .price-history ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .price-history li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #F0F0F0;
    font-size: 0.9rem;
  }
  .price-history li:last-child {
    border-bottom: none;
  }
  .delta {
    font-weight: 700;
    width: 1rem;
  }
  .delta-up {
    color: #DC2626;
  }
  .delta-down {
    color: var(--green);
  }
  .history-date {
    color: var(--slate, #313748);
  }
  .history-price {
    font-weight: 700;
    color: var(--navy);
  }
  .history-discount {
    color: #888;
  }
</style>
