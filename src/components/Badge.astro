---
interface Props {
  variant: 'gold' | 'green' | 'orange';
  label: string;
  size?: 'md' | 'sm';
}
const { variant, label, size = 'md' } = Astro.props;
---

<span class:list={['badge-pill', `badge-${variant}`, `badge-${size}`]}>{label}</span>

<style>
  .badge-pill {
    display: inline-block;
    font-family: 'Baloo 2', sans-serif;
    font-weight: 700;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge-md {
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
  }
  .badge-sm {
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    text-transform: uppercase;
  }
  .badge-orange {
    background: var(--orange);
    color: white;
    box-shadow: 0 2px 6px rgba(255, 99, 22, 0.4);
  }
  .badge-gold {
    background: var(--gold);
    color: var(--navy);
    box-shadow: 0 2px 6px rgba(255, 193, 69, 0.5);
  }
  .badge-green {
    background: var(--green-bg);
    color: var(--green);
  }
</style>
